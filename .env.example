# Supabase project (Settings -> API). Both values are public and safe in the browser:
# every request is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server-only. NEVER prefix with NEXT_PUBLIC_ and never read it in browser code.
# Used by admin server routes (real account suspension/ban via auth.admin) and
# scripts/seed-sample-students.ts.
SUPABASE_SERVICE_ROLE_KEY=

# TURN relay for WebRTC — REQUIRED for phone <-> PC calls across different
# networks (without it cross-network rooms fall back to STUN-only and stay
# silent). Any provider works: Cloudflare Realtime TURN (free tier), Metered
# (20 GB/month), or your own coturn.
#   COVA_TURN_URLS        e.g. "turn:standard.relay.metered.ca:80" (comma list allowed)
#   COVA_TURN_USERNAME    the username / key id
#   COVA_TURN_CREDENTIAL  the credential / secret
COVA_TURN_URLS=
COVA_TURN_USERNAME=
COVA_TURN_CREDENTIAL=

# Optional: fixed HMAC secret (32+ chars) for the signed room tokens. Only
# needed when running MULTIPLE server instances behind one domain — room state
# itself is single-instance anyway, and a random per-process secret is used
# when this is unset.
COVA_ROOM_SECRET=
